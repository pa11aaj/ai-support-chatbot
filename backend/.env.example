# Copy this file to .env and fill in your real key. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=http://localhost:5173

# Cost / abuse protection (all optional - sensible defaults if omitted)
MAX_REPLY_TOKENS=300          # caps the length (and cost) of each AI response
PER_IP_MAX_REQUESTS=10        # max messages a single visitor can send...
PER_IP_WINDOW_SECONDS=60      # ...per this many seconds
GLOBAL_DAILY_LIMIT=300        # hard cap on total messages/day across all visitors
